# ── Runtime ────────────────────────────────────────────────────────────────
# Production deploys run with NODE_ENV=production; the app refuses to start with
# development-grade configuration in that mode (see env.assertProductionSafety).
NODE_ENV=development
PORT=4000
# Public origin of the Express API itself. Used for absolute URLs — including
# the supplier purchase-order callback link — so it must be the real public
# origin in production. No trailing slash.
#   Production: https://api.etoile-dumatin.com
#   Local dev:  http://localhost:4000
API_PUBLIC_URL=https://api.etoile-dumatin.com

# Comma-separated allowlist of browser origins permitted to call this API.
# These are reflected in both `Access-Control-Allow-Origin` and the CSRF
# origin check. Do NOT use "*" — it is incompatible with credentials. (An
# unknown Origin is rejected, but note that production does not currently
# refuse to boot on a wildcard/localhost entry here.)
#   Production: https://etoile-dumatin.com
#   Local dev:  http://localhost:5173,http://localhost:8080
CORS_ORIGINS=https://etoile-dumatin.com,http://localhost:5173,http://localhost:8080

# Domain attribute for the auth cookies (refresh + CSRF). Required when the SPA
# and the API are on different subdomains, e.g. a site at etoile-dumatin.com
# calling an API at api.etoile-dumatin.com: without it the host-only `edm_csrf`
# cookie is unreadable by `document.cookie` on the SPA's origin, so the CSRF
# header is never sent and every /api/auth/refresh is a 403.
#   Production: .etoile-dumatin.com
#   Local dev / same-origin: leave blank
#
# The common `api.<site>` layout is detected automatically from API_PUBLIC_URL
# and CORS_ORIGINS, so leaving this blank normally just works; set it explicitly
# for any other arrangement (e.g. the site on www.<site> calling api.<site>).
COOKIE_DOMAIN=

# The Stripe webhook route is authenticated by signature verification
# (STRIPE_WEBHOOK_SECRET) and mounted before the CORS and origin guards, since
# Stripe sends no Origin header. There is no separate origin allowlist to
# configure: WEBHOOK_ALLOWED_ORIGINS was removed because nothing read it.

# ── Database ───────────────────────────────────────────────────────────────
#mysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
# Use a dedicated least-privilege user. Never connect as root from the app.
#
# Percent-encode @ : / # % in the password (they are structural in a URL):
# p@ss:word becomes p%40ss%3Aword. This is the most common cause of a
# correct-looking URL that fails to connect.
#
# TLS: any host that is not loopback is encrypted and verified whether or not you
# ask for it, and `ssl-mode=DISABLED` is refused for remote hosts. `ssl-mode` is
# Connector/J syntax that mysql2 silently ignores, so it is translated into a real
# TLS profile rather than passed through. Do not expect it to switch TLS off.
DATABASE_URL=mysql://etoil_app:CHANGE_ME@127.0.0.1:3306/etoil_du_matin
# Same server, used only by drizzle-kit (migrations). May hold DDL rights.
DATABASE_MIGRATION_URL=mysql://etoil_migrator:CHANGE_ME@127.0.0.1:3306/etoil_du_matin
DB_POOL_SIZE=10

# Managed providers (Aiven, PlanetHost and similar) usually sign with a private CA
# that chains to no public root, so the system trust store rejects them with
# "self-signed certificate in certificate chain" - an error that points at nothing
# useful. Supply the provider's CA and the connection will verify. During a CA
# rotation the downloaded file normally contains both CAs.
# Leave both unset when the server uses a publicly trusted certificate.
#DATABASE_SSL_CA=
#DATABASE_SSL_CA_FILE=./certs/aiven-ca.pem

# ── Secrets ────────────────────────────────────────────────────────────────
# Generate each with: openssl rand -base64 48
# JWT_SECRET signs short-lived access tokens (HS256). Min 32 chars.
JWT_SECRET=
# Signs the CSRF cookie HMAC. Min 32 chars.
CSRF_SECRET=
# Pepper mixed into passwords before argon2. Min 16 chars.
PASSWORD_PEPPER=

# ── Tokens ─────────────────────────────────────────────────────────────────
# Access token lifetime in SECONDS (allowed 60-3600). 900 = 15 minutes.
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token / session lifetime in DAYS (allowed 1-365). Drives the rotating
# refresh token, its cookie Max-Age, and the session row. There is no
# seconds-based variant.
REFRESH_TOKEN_TTL_DAYS=30
# Idempotent-rotation grace window in SECONDS (allowed 0-3600). If a token that
# was rotated away from is presented again within this window and its family
# still has a live successor, that successor is rotated instead of revoking the
# family (the client raced itself). Outside the window a replay revokes the
# family as a theft signal. Defaults to 30 in production and 0 elsewhere; set 0
# to disable. See REFRESH_REUSE_GRACE_SECONDS in src/env.ts.
REFRESH_REUSE_GRACE_SECONDS=30

# ── Rate limiting ───────────────────────────────────────────────────────────
# Counters are per-process and keyed by client IP (middleware/security.ts), so
# TRUST_PROXY must be correct or they all share one bucket. Values shown are the
# built-in defaults; override only with a reason. The unauthenticated
# contact/newsletter endpoints carry the tightest ceilings because anyone can
# POST to them without an account.
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
# Refresh runs on every page load, so it gets its own (looser) ceiling rather
# than spending the login budget above.
RATE_LIMIT_REFRESH_MAX=60
RATE_LIMIT_REFRESH_WINDOW_MS=900000
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_CHECKOUT_MAX=20
RATE_LIMIT_CHECKOUT_WINDOW_MS=60000
RATE_LIMIT_READ_MAX=120
RATE_LIMIT_READ_WINDOW_MS=60000
RATE_LIMIT_WRITE_MAX=60
RATE_LIMIT_WRITE_WINDOW_MS=60000
RATE_LIMIT_CONTACT_MAX=5
RATE_LIMIT_CONTACT_WINDOW_MS=3600000

# ── Orders & stock reservations ─────────────────────────────────────────────
# How long a checkout holds reserved stock before releasing it (minutes).
PENDING_ORDER_TTL_MINUTES=30
# Upper bound on orders released per sweep, and how often the sweep runs (ms).
ORDER_SWEEP_BATCH_SIZE=200
ORDER_SWEEP_INTERVAL_MS=300000

# ── Reverse proxy ───────────────────────────────────────────────────────────
# Set to true ONLY when the app really sits behind a proxy you control (nginx,
# Cloudflare, a load balancer) AND that proxy overwrites the X-Forwarded-For
# header. Rate limiting and per-account lockout key off the client IP, so a
#   blind `true` lets any client spoof its address and bypass both.
#   Production (Passenger / nginx / LiteSpeed in front): true
#   Local dev (no proxy in front): false
# NOTE: this is NOT enforced at boot today (see env.assertProductionSafety), so
# a production box left on `false` silently collapses every visitor into one
# shared rate-limit bucket. Set it to true in production.
TRUST_PROXY=false

# ── Stripe ─────────────────────────────────────────────────────────────────
# Secret key, sk_test_... / sk_live_...
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:4000/api/webhooks/stripe` or the
# dashboard's webhook endpoint settings.
STRIPE_WEBHOOK_SECRET=
# Publishable key — safe to expose to the browser.
STRIPE_PUBLISHABLE_KEY=
# Currency for all money amounts (ISO 4217, lowercase).
STORE_CURRENCY=usd

# ── Email (order confirmations / shipping notices) ─────────────────────────
# Optional. Without these, confirmations are logged as skipped instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Étoile du Matin <orders@etoile-dumatin.com>"

# ── Store ──────────────────────────────────────────────────────────────────
SUPPORT_EMAIL=support@etoile-dumatin.com
# Flat shipping rate in minor units (cents) applied below the free threshold.
SHIPPING_FLAT_CENTS=900
# Order subtotal (cents) at or above which shipping is free.
FREE_SHIPPING_THRESHOLD_CENTS=7500
# Tax rate in basis points (800 = 8.00%).
TAX_BASIS_POINTS=800
