# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public origin of the Express API itself (used for the OAuth-ish redirects
# and to build absolute URLs). Never include a trailing slash.
API_PUBLIC_URL=http://localhost:4000

# Comma-separated allowlist of browser origins permitted to call this API.
# These are reflected in both `Access-Control-Allow-Origin` and the CSRF
# origin check. Do NOT use "*" — it is incompatible with credentials.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# The Stripe webhook route is authenticated by signature verification
# (STRIPE_WEBHOOK_SECRET) and mounted before the CORS and origin guards, since
# Stripe sends no Origin header. There is no separate origin allowlist to
# configure: WEBHOOK_ALLOWED_ORIGINS was removed because nothing read it.

# ── Database ───────────────────────────────────────────────────────────────
#mysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
# Use a dedicated least-privilege user. Never connect as root from the app.
#
# Percent-encode @ : / # % in the password (they are structural in a URL):
# p@ss:word becomes p%40ss%3Aword. This is the most common cause of a
# correct-looking URL that fails to connect.
#
# TLS: any host that is not loopback is encrypted and verified whether or not you
# ask for it, and `ssl-mode=DISABLED` is refused for remote hosts. `ssl-mode` is
# Connector/J syntax that mysql2 silently ignores, so it is translated into a real
# TLS profile rather than passed through. Do not expect it to switch TLS off.
DATABASE_URL=mysql://etoil_app:CHANGE_ME@127.0.0.1:3306/etoil_du_matin
# Same server, used only by drizzle-kit (migrations). May hold DDL rights.
DATABASE_MIGRATION_URL=mysql://etoil_migrator:CHANGE_ME@127.0.0.1:3306/etoil_du_matin
DB_POOL_SIZE=10

# Managed providers (Aiven, PlanetHost and similar) usually sign with a private CA
# that chains to no public root, so the system trust store rejects them with
# "self-signed certificate in certificate chain" - an error that points at nothing
# useful. Supply the provider's CA and the connection will verify. During a CA
# rotation the downloaded file normally contains both CAs.
# Leave both unset when the server uses a publicly trusted certificate.
#DATABASE_SSL_CA=
#DATABASE_SSL_CA_FILE=./certs/aiven-ca.pem

# ── Secrets ────────────────────────────────────────────────────────────────
# Generate each with: openssl rand -base64 48
# JWT_SECRET signs short-lived access tokens (HS256). Min 32 chars.
JWT_SECRET=
# Signs the CSRF cookie HMAC. Min 32 chars.
CSRF_SECRET=
# Pepper mixed into passwords before argon2. Min 16 chars.
PASSWORD_PEPPER=

# ── Tokens ─────────────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Public contact form and newsletter signup are unauthenticated, so these are
# keyed by IP and are the tightest ceilings in the file. Five messages an hour is
# generous for a real visitor and cheap for a spammer to hit.
RATE_LIMIT_CONTACT_MAX=5
RATE_LIMIT_CONTACT_WINDOW_MS=3600000

# ── Reverse proxy ───────────────────────────────────────────────────────────
# Set to true ONLY when the app really sits behind a proxy you control (nginx,
# Cloudflare, a load balancer) AND that proxy overwrites the X-Forwarded-For
# header. Rate limiting and per-account lockout key off the client IP, so a
# blind `true` lets any client spoof its address and bypass both.
# Production refuses to start unless this is enabled.
TRUST_PROXY=false

# ── Stripe ─────────────────────────────────────────────────────────────────
# Secret key, sk_test_... / sk_live_...
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:4000/api/webhooks/stripe` or the
# dashboard's webhook endpoint settings.
STRIPE_WEBHOOK_SECRET=
# Publishable key — safe to expose to the browser.
STRIPE_PUBLISHABLE_KEY=
# Currency for all money amounts (ISO 4217, lowercase).
STORE_CURRENCY=usd

# ── Email (order confirmations / shipping notices) ─────────────────────────
# Optional. Without these, confirmations are logged as skipped instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Étoile du Matin <orders@example.com>"

# ── Store ──────────────────────────────────────────────────────────────────
SUPPORT_EMAIL=support@example.com
# Flat shipping rate in minor units (cents) applied below the free threshold.
SHIPPING_FLAT_CENTS=900
# Order subtotal (cents) at or above which shipping is free.
FREE_SHIPPING_THRESHOLD_CENTS=7500
# Tax rate in basis points (800 = 8.00%).
TAX_BASIS_POINTS=800
